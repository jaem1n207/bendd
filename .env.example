# 공개 DSN과 측정 ID. 값이 없으면 해당 서비스는 동작하지 않습니다.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Production/Preview에 각각 production/preview를 지정하세요.
NEXT_PUBLIC_VERCEL_ENV=
# 선택: 미설정 시 Sentry 빌드 플러그인이 Git revision을 주입합니다.
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=

# 선택: 읽을 수 있는 stack trace를 위한 source map 업로드
# SENTRY_AUTH_TOKEN은 Vercel 환경 변수/로컬 .env.local에만 저장하세요.
SENTRY_ORG=jaemin
SENTRY_PROJECT=bendd
SENTRY_AUTH_TOKEN=
