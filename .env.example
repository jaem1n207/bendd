# 공개 DSN과 측정 ID. 값이 없으면 해당 서비스는 동작하지 않습니다.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Production/Preview에 각각 production/preview를 지정하세요.
NEXT_PUBLIC_VERCEL_ENV=
# 선택: 미설정 시 Sentry 빌드 플러그인이 Git revision을 주입합니다.
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=

# 소스맵 자동 업로드: Vercel Production/Preview에는 아래 세 변수가 필수입니다.
# 로컬 개발·GitHub CI에는 토큰이 필요하지 않습니다. 로컬 업로드를 할 때만 설정하세요.
# org:ci 조직 토큰은 Vercel의 Sensitive 변수에 저장하세요.
# 새 MacBook 설정·토큰 교체·실패 대응: docs/observability.md
# NEXT_PUBLIC_ 접두사를 붙이거나 Git/채팅에 토큰을 넣지 마세요.
SENTRY_ORG=jaemin
SENTRY_PROJECT=bendd
SENTRY_AUTH_TOKEN=
