{
  "name": "bendd",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "-------------------------------------------------": "",
    "dev": "node scripts/generate-home-font.mjs && next dev --webpack",
    "start": "next start",
    "build": "node scripts/generate-home-font.mjs && next build --webpack",
    "build-stats": "ANALYZE=true pnpm build",
    "------------------------------------------------": "",
    "clean": "rimraf .next",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx}\" --cache",
    "check-types": "tsc --noEmit --pretty",
    "-----------------------------------------------": "",
    "cz": "czg checkbox",
    "prepare": "husky",
    "fonts:home": "node scripts/generate-home-font.mjs",
    "test:availability": "node --test --test-timeout=10000 scripts/availability/*.test.mjs",
    "test:incident": "node --test --test-timeout=10000 scripts/incident-response/*.test.mjs",
    "incident:manage": "node scripts/incident-response/install.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@sentry/nextjs": "^11.4.0",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "16.4.0",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-use": "^17.5.0",
    "react-use-measure": "^2.1.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^6.2.2",
    "zod": "^3.23.8",
    "zod-validation-error": "^3.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.0",
    "@playwright/test": "^1.44.1",
    "@shikijs/transformers": "^2.5.0",
    "@shikijs/twoslash": "^2.5.0",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "3.2.6",
    "czg": "^1.9.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-tailwindcss": "^3.17.4",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.0.11",
    "jsdom": "^24.1.0",
    "lint-staged": "^15.2.6",
    "postcss": "^8.5.23",
    "prettier": "3.2.5",
    "rehype-pretty-code": "^0.14.4",
    "rehype-slug": "^6.0.0",
    "remark-smartypants": "^3.0.1",
    "schema-dts": "^1.1.2",
    "shiki": "^2.5.0",
    "shiki-magic-move": "1.0.0",
    "subset-font": "2.9.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "4.1.11"
  }
}
